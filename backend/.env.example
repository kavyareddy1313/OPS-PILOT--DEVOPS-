# OpsPilot Backend Environment Variables Template
PORT=5001
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL=postgresql://opspilot_user:opspilot_secure_password_2026@localhost:5432/opspilot
PGHOST=localhost
PGPORT=5432
PGDATABASE=opspilot
PGUSER=opspilot_user
PGPASSWORD=opspilot_secure_password_2026

# Target Monitored Microservice
DEMO_SERVICE_URL=http://localhost:5002

# Health Check Probe Frequency (in milliseconds)
PROBE_INTERVAL_MS=5000
